ce/s7_5_f2c0be8930.mp3", "start": 130.362, "dur": 4.084}, {"file": "小紅帽/voice/s7_6_4ba334b649.mp3", "start": 134.746, "dur": 2.696}, {"file": "小紅帽/voice/s7_7_d5a5ab5104.mp3", "start": 137.742, "dur": 3.422}, {"file": "小紅帽/voice/s7_8_5fe5bef9bd.mp3", "start": 141.464, "dur": 3.394}, {"file": "小紅帽/voice/s7_9_f66a19ff1b.mp3", "start": 145.459, "dur": 3.036}, {"file": "小紅帽/voice/s7_10_86c18f36b2.mp3", "start": 148.795, "dur": 3.607}, {"file": "小紅帽/voice/s7_11_5295c120e6.mp3", "start": 152.702, "dur": 5.241}, {"file": "小紅帽/voice/s8_1_26bcb718ef.mp3", "start": 158.742, "dur": 3.548}, {"file": "小紅帽/voice/s8_2_340a99e6dd.mp3", "start": 162.591, "dur": 5.172}, {"file": "小紅帽/voice/s8_3_1e881f02f7.mp3", "start": 168.063, "dur": 1.674}, {"file": "小紅帽/voice/s9_1_f8eff344e8.mp3", "start": 170.437, "dur": 8.17}, {"file": "小紅帽/voice/s9_2_0ae1c7a803.mp3", "start": 178.907, "dur": 5.961}, {"file": "小紅帽/voice/s9_3_7544e11848.mp3", "start": 185.168, "dur": 9.827}, {"file": "小紅帽/voice/s9_4_c87f96b172.mp3", "start": 195.295, "dur": 4.568}, {"file": "小紅帽/voice/s9_5_fe3d61475d.mp3", "start": 200.164, "dur": 4.748}, {"file": "小紅帽/voice/s9_6_67ca513d65.mp3", "start": 205.212, "dur": 8.838}, {"file": "小紅帽/voice/s10_1_d581b70d3f.mp3", "start": 214.849, "dur": 7.222}, {"file": "小紅帽/voice/s10_2_7c5d412166.mp3", "start": 222.372, "dur": 4.797}, {"file": "小紅帽/voice/s10_3_c08b610cf3.mp3", "start": 227.469, "dur": 6.074}, {"file": "小紅帽/voice/bgm_canon.wav", "start": 227.469, "dur": 30.0, "vol": 0.32}], "subs": [{"t0": 0.3, "t1": 1.151, "text": "從前從前，", "who": "卡洛兒姐姐"}, {"t0": 1.271, "t1": 3.286, "text": "在森林旁邊的小木屋裡，", "who": "卡洛兒姐姐"}, {"t0": 3.406, "t1": 5.422, "text": "住著一個可愛的小女孩。", "who": "卡洛兒姐姐"}, {"t0": 5.842, "t1": 8.071, "text": "她總是披著外婆送的紅色斗篷，", "who": "卡洛兒姐姐"}, {"t0": 8.191, "t1": 10.085, "text": "所以大家都叫她「小紅帽", "who": "卡洛兒姐姐"}, {"t0": 10.205, "t1": 10.505, "text": "。", "who": "卡洛兒姐姐"}, {"t0": 10.673, "t1": 11.269, "text": "有一天，", "who": "卡洛兒姐姐"}, {"t0": 11.389, "t1": 12.344, "text": "媽媽對她說：", "who": "卡洛兒姐姐"}, {"t0": 12.464, "t1": 13.598, "text": "外婆生病了，", "who": "卡洛兒姐姐"}, {"t0": 13.718, "t1": 16.285, "text": "把這籃蛋糕和葡萄酒送去給她吧。", "who": "卡洛兒姐姐"}, {"t0": 16.405, "t1": 17.718, "text": "記得別離開小路，", "who": "卡洛兒姐姐"}, {"t0": 17.838, "t1": 19.688, "text": "也不要和陌生人說話喔。", "who": "卡洛兒姐姐"}, {"t0": 19.808, "t1": 20.108, "text": "", "who": "卡洛兒姐姐"}, {"t0": 20.287, "t1": 20.703, "text": "好的，", "who": "小紅帽"}, {"t0": 20.823, "t1": 21.238, "text": "媽媽！", "who": "小紅帽"}, {"t0": 21.358, "t1": 22.843, "text": "我一定乖乖走小路，", "who": "小紅帽"}, {"t0": 22.963, "t1": 24.805, "text": "馬上把蛋糕送去給外婆！", "who": "小紅帽"}, {"t0": 25.725, "t1": 27.157, "text": "小紅帽提著籃子，", "who": "卡洛兒姐姐"}, {"t0": 27.277, "t1": 29.292, "text": "開開心心地走進了森林。", "who": "卡洛兒姐姐"}, {"t0": 29.712, "t1": 30.392, "text": "啦啦啦～", "who": "小紅帽"}, {"t0": 30.512, "t1": 31.792, "text": "外婆吃到蛋糕，", "who": "小紅帽"}, {"t0": 31.912, "t1": 33.992, "text": "病一定很快就會好起來！", "who": "小紅帽"}, {"t0": 34.812, "t1": 35.409, "text": "這時候，", "who": "卡洛兒姐姐"}, {"t0": 35.529, "t1": 38.099, "text": "一隻大野狼從大樹後面走了出來。", "who": "卡洛兒姐姐"}, {"t0": 38.519, "t1": 39.056, "text": "嘿嘿，", "who": "大野狼"}, {"t0": 39.176, "t1": 40.59, "text": "可愛的小姑娘，", "who": "大野狼"}, {"t0": 40.71, "t1": 42.78, "text": "妳一個人要去哪裡呀？", "who": "大野狼"}, {"t0": 43.2, "t1": 44.885, "text": "我要去森林的另一頭，", "who": "小紅帽"}, {"t0": 45.005, "t1": 46.329, "text": "探望生病的外婆。", "who": "小紅帽"}, {"t0": 46.749, "t1": 47.097, "text": "喔？", "who": "大野狼"}, {"t0": 47.217, "t1": 49.436, "text": "那妳外婆住在哪裡呢？", "who": "大野狼"}, {"t0": 49.856, "t1": 52.35, "text": "就在三棵大橡樹下面的小木屋呀！", "who": "小紅帽"}, {"t0": 52.77, "t1": 53.428, "text": "嘿嘿…", "who": "大野狼"}, {"t0": 53.548, "t1": 53.848, "text": "…", "who": "大野狼"}, {"t0": 53.807, "t1": 55.241, "text": "一個老奶奶，", "who": "大野狼"}, {"t0": 55.361, "t1": 57.574, "text": "再加上一個小女孩，", "who": "大野狼"}, {"t0": 57.694, "t1": 60.683, "text": "今天可以好好飽餐一頓了。", "who": "大野狼"}, {"t0": 61.503, "t1": 62.169, "text": "小紅帽，", "who": "大野狼"}, {"t0": 62.289, "t1": 62.759, "text": "妳看，", "who": "大野狼"}, {"t0": 62.879, "t1": 64.724, "text": "那邊的花開得多漂亮！", "who": "大野狼"}, {"t0": 64.844, "t1": 66.885, "text": "何不摘一束送給外婆呢？", "who": "大野狼"}, {"t0": 67.305, "t1": 67.789, "text": "對耶！", "who": "小紅帽"}, {"t0": 67.909, "t1": 68.997, "text": "外婆看到花，", "who": "小紅帽"}, {"t0": 69.117, "t1": 70.608, "text": "一定會很開心的！", "who": "小紅帽"}, {"t0": 71.028, "t1": 73.235, "text": "小紅帽忘了媽媽的叮嚀，", "who": "卡洛兒姐姐"}, {"t0": 73.355, "t1": 74.293, "text": "跑去摘花；", "who": "卡洛兒姐姐"}, {"t0": 74.413, "t1": 75.985, "text": "大野狼卻悄悄地，", "who": "卡洛兒姐姐"}, {"t0": 76.105, "t1": 77.678, "text": "往外婆家跑去了…", "who": "卡洛兒姐姐"}, {"t0": 77.798, "t1": 78.098, "text": "…", "who": "卡洛兒姐姐"}, {"t0": 79.309, "t1": 81.838, "text": "大野狼一路跑到外婆家門口，", "who": "卡洛兒姐姐"}, {"t0": 81.958, "t1": 83.265, "text": "輕輕敲了敲門。", "who": "卡洛兒姐姐"}, {"t0": 83.685, "t1": 84.649, "text": "外婆，", "who": "大野狼"}, {"t0": 84.769, "t1": 85.732, "text": "是我，", "who": "大野狼"}, {"t0": 85.852, "t1": 87.177, "text": "小紅帽。", "who": "大野狼"}, {"t0": 87.297, "t1": 90.429, "text": "我帶蛋糕來看您了。", "who": "大野狼"}, {"t0": 91.249, "t1": 92.444, "text": "門沒有鎖，", "who": "外婆"}, {"t0": 92.564, "t1": 94.022, "text": "自己進來吧，", "who": "外婆"}, {"t0": 94.142, "t1": 95.074, "text": "乖孩子。", "who": "外婆"}, {"t0": 95.494, "t1": 96.628, "text": "大野狼推開門，", "who": "卡洛兒姐姐"}, {"t0": 96.748, "t1": 98.242, "text": "一個箭步衝到床邊，", "who": "卡洛兒姐姐"}, {"t0": 98.362, "t1": 99.138, "text": "張開大嘴，", "who": "卡洛兒姐姐"}, {"t0": 99.258, "t1": 101.468, "text": "一口就把外婆吞進了肚子裡！", "who": "卡洛兒姐姐"}, {"t0": 101.888, "t1": 102.91, "text": "嘿嘿嘿，", "who": "大野狼"}, {"t0": 103.03, "t1": 104.051, "text": "接下來，", "who": "大野狼"}, {"t0": 104.171, "t1": 107.475, "text": "就等小紅帽自己送上門囉！", "who": "大野狼"}, {"t0": 108.395, "t1": 110.413, "text": "大野狼穿上外婆的睡衣、", "who": "卡洛兒姐姐"}, {"t0": 110.533, "t1": 111.385, "text": "戴上睡帽，", "who": "卡洛兒姐姐"}, {"t0": 111.505, "t1": 112.551, "text": "躲進了被窩。", "who": "卡洛兒姐姐"}, {"t0": 112.671, "t1": 113.134, "text": "不久，", "who": "卡洛兒姐姐"}, {"t0": 113.254, "t1": 115.273, "text": "小紅帽抱著一束花來了。", "who": "卡洛兒姐姐"}, {"t0": 115.693, "t1": 116.376, "text": "外婆，", "who": "小紅帽"}, {"t0": 116.496, "t1": 117.446, "text": "我來了！", "who": "小紅帽"}, {"t0": 117.566, "t1": 117.982, "text": "咦…", "who": "小紅帽"}, {"t0": 118.102, "t1": 118.402, "text": "…", "who": "小紅帽"}, {"t0": 118.369, "t1": 119.052, "text": "外婆，", "who": "小紅帽"}, {"t0": 119.172, "t1": 121.729, "text": "您的耳朵怎麼這麼大？", "who": "小紅帽"}, {"t0": 122.149, "t1": 123.187, "text": "耳朵大，", "who": "大野狼"}, {"t0": 123.307, "t1": 127.239, "text": "才能把妳的聲音聽得更清楚呀。", "who": "大野狼"}, {"t0": 127.659, "t1": 128.054, "text": "外婆，", "who": "小紅帽"}, {"t0": 128.174, "t1": 129.942, "text": "那您的眼睛怎麼這麼大？", "who": "小紅帽"}, {"t0": 130.362, "t1": 131.331, "text": "眼睛大，", "who": "大野狼"}, {"t0": 131.451, "t1": 134.326, "text": "才能把妳看得更仔細呀。", "who": "大野狼"}, {"t0": 134.746, "t1": 135.248, "text": "外婆，", "who": "小紅帽"}, {"t0": 135.368, "t1": 137.322, "text": "那您的手怎麼這麼大？", "who": "小紅帽"}, {"t0": 137.742, "t1": 138.412, "text": "手大，", "who": "大野狼"}, {"t0": 138.532, "t1": 141.044, "text": "才能把妳抱得更緊呀。", "who": "大野狼"}, {"t0": 141.464, "t1": 141.769, "text": "那…", "who": "小紅帽"}, {"t0": 141.889, "t1": 142.189, "text": "…", "who": "小紅帽"}, {"t0": 142.101, "t1": 142.617, "text": "外婆，", "who": "小紅帽"}, {"t0": 142.737, "t1": 144.739, "text": "您的嘴巴怎麼這麼大？", "who": "小紅帽"}, {"t0": 145.459, "t1": 146.273, "text": "嘴巴大，", "who": "大野狼"}, {"t0": 146.393, "t1": 148.375, "text": "才能一口把妳吃掉！", "who": "大野狼"}, {"t0": 148.795, "t1": 150.314, "text": "大野狼從床上跳起來，", "who": "卡洛兒姐姐"}, {"t0": 150.434, "t1": 152.282, "text": "一口把小紅帽也吞了下去。", "who": "卡洛兒姐姐"}, {"t0": 152.702, "t1": 154.547, "text": "吃得飽飽的大野狼，", "who": "卡洛兒姐姐"}, {"t0": 154.667, "t1": 155.857, "text": "又躺回床上，", "who": "卡洛兒姐姐"}, {"t0": 155.977, "t1": 157.822, "text": "呼嚕呼嚕地睡著了。", "who": "卡洛兒姐姐"}, {"t0": 158.742, "t1": 159.411, "text": "這時候，", "who": "卡洛兒姐姐"}, {"t0": 159.531, "t1": 162.171, "text": "一位獵人正好經過外婆家門口。", "who": "卡洛兒姐姐"}, {"t0": 162.591, "t1": 162.921, "text": "咦？", "who": "獵人"}, {"t0": 163.041, "t1": 165.619, "text": "外婆的打呼聲怎麼這麼大？", "who": "獵人"}, {"t0": 165.739, "t1": 167.643, "text": "平常可不是這樣的。", "who": "獵人"}, {"t0": 168.063, "t1": 168.552, "text": "不對勁，", "who": "獵人"}, {"t0": 168.672, "t1": 169.617, "text": "我得進去看看！", "who": "獵人"}, {"t0": 170.437, "t1": 172.184, "text": "獵人輕輕推開門，", "who": "卡洛兒姐姐"}, {"t0": 172.304, "t1": 175.219, "text": "看見大野狼穿著外婆的睡衣，", "who": "卡洛兒姐姐"}, {"t0": 175.339, "t1": 177.32, "text": "挺著圓滾滾的肚子，", "who": "卡洛兒姐姐"}, {"t0": 177.44, "t1": 178.487, "text": "睡得正香。", "who": "卡洛兒姐姐"}, {"t0": 178.907, "t1": 180.995, "text": "原來是你這隻壞野狼！", "who": "獵人"}, {"t0": 181.115, "t1": 182.32, "text": "肚子這麼鼓，", "who": "獵人"}, {"t0": 182.44, "t1": 184.748, "text": "外婆一定被你吞下去了！", "who": "獵人"}, {"t0": 185.168, "t1": 186.577, "text": "獵人拿出剪刀，", "who": "卡洛兒姐姐"}, {"t0": 186.697, "t1": 189.634, "text": "小心翼翼地剪開大野狼的肚子。", "who": "卡洛兒姐姐"}, {"t0": 189.754, "t1": 191.818, "text": "先跳出來的是小紅帽，", "who": "卡洛兒姐姐"}, {"t0": 191.938, "t1": 192.473, "text": "接著，", "who": "卡洛兒姐姐"}, {"t0": 192.593, "t1": 194.875, "text": "外婆也平安地爬了出來！", "who": "卡洛兒姐姐"}, {"t0": 195.295, "t1": 196.508, "text": "謝謝獵人叔叔！", "who": "小紅帽"}, {"t0": 196.628, "t1": 198.792, "text": "大野狼的肚子裡又黑又悶，", "who": "小紅帽"}, {"t0": 198.912, "t1": 199.744, "text": "好可怕喔！", "who": "小紅帽"}, {"t0": 200.164, "t1": 200.535, "text": "別怕，", "who": "獵人"}, {"t0": 200.655, "t1": 201.19, "text": "沒事了。", "who": "獵人"}, {"t0": 201.31, "t1": 203.646, "text": "我們撿些大石頭塞進牠的肚子裡，", "who": "獵人"}, {"t0": 203.766, "t1": 204.792, "text": "給牠一點教訓！", "who": "獵人"}, {"t0": 205.212, "t1": 206.565, "text": "大野狼醒來，", "who": "卡洛兒姐姐"}, {"t0": 206.685, "t1": 209.02, "text": "只覺得肚子好重好重，", "who": "卡洛兒姐姐"}, {"t0": 209.14, "t1": 211.474, "text": "搖搖晃晃地逃進森林，", "who": "卡洛兒姐姐"}, {"t0": 211.594, "t1": 213.929, "text": "從此再也不敢出現了。", "who": "卡洛兒姐姐"}, {"t0": 214.849, "t1": 215.84, "text": "謝謝你，", "who": "外婆"}, {"t0": 215.96, "t1": 217.507, "text": "好心的獵人。", "who": "外婆"}, {"t0": 217.627, "t1": 218.618, "text": "小紅帽，", "who": "外婆"}, {"t0": 218.738, "t1": 219.452, "text": "快來，", "who": "外婆"}, {"t0": 219.572, "t1": 221.952, "text": "我們一起吃蛋糕吧。", "who": "外婆"}, {"t0": 222.372, "t1": 222.748, "text": "外婆，", "who": "獵人"}, {"t0": 222.868, "t1": 223.74, "text": "您好好休息。", "who": "獵人"}, {"t0": 223.86, "t1": 225.56, "text": "以後有我在森林裡巡邏，", "who": "獵人"}, {"t0": 225.68, "t1": 227.049, "text": "大家都可以放心了。", "who": "獵人"}, {"t0": 227.469, "t1": 228.65, "text": "我知道錯了。", "who": "小紅帽"}, {"t0": 228.77, "t1": 231.037, "text": "以後我一定乖乖走小路，", "who": "小紅帽"}, {"t0": 231.157, "t1": 233.423, "text": "再也不跟陌生人說話了！", "who": "小紅帽"}]}