"file": "青蛙王子/voice/s6_1_915e7f3488.mp3", "start": 118.047, "dur": 5.683}, {"file": "青蛙王子/voice/s6_2_41277e4074.mp3", "start": 124.029, "dur": 3.228}, {"file": "青蛙王子/voice/s6_3_d593c0989e.mp3", "start": 127.558, "dur": 5.009}, {"file": "青蛙王子/voice/s6_4_43772d46fb.mp3", "start": 132.867, "dur": 3.323}, {"file": "青蛙王子/voice/s7_1_716e478bdb.mp3", "start": 137.59, "dur": 6.053}, {"file": "青蛙王子/voice/s7_2_846179295a.mp3", "start": 143.943, "dur": 1.841}, {"file": "青蛙王子/voice/s7_3_13d2acb716.mp3", "start": 146.084, "dur": 2.097}, {"file": "青蛙王子/voice/s7_4_a8f739990f.mp3", "start": 148.481, "dur": 7.292}, {"file": "青蛙王子/voice/s7_5_bd7e45550d.mp3", "start": 156.073, "dur": 3.122}, {"file": "青蛙王子/voice/s7_6_b3649eae9a.mp3", "start": 159.495, "dur": 3.901}, {"file": "青蛙王子/voice/s8_1_0b3d250149.mp3", "start": 164.195, "dur": 3.514}, {"file": "青蛙王子/voice/s8_2_c3f7c3347d.mp3", "start": 168.009, "dur": 3.572}], "subs": [{"t0": 0.3, "t1": 0.98, "text": "小朋友", "who": "卡洛兒姐姐"}, {"t0": 1.1, "t1": 3.542, "text": "今天卡洛兒姐姐要說的故事是", "who": "卡洛兒姐姐"}, {"t0": 3.662, "t1": 4.948, "text": "《青蛙王子》！", "who": "卡洛兒姐姐"}, {"t0": 7.568, "t1": 10.658, "text": "很久很久以前　在一座美麗的城堡裡", "who": "卡洛兒姐姐"}, {"t0": 10.778, "t1": 12.69, "text": "住著一位可愛的小公主", "who": "卡洛兒姐姐"}, {"t0": 13.11, "t1": 15.031, "text": "小公主最喜歡的玩具", "who": "卡洛兒姐姐"}, {"t0": 15.151, "t1": 17.3, "text": "就是一顆亮晶晶的金球", "who": "卡洛兒姐姐"}, {"t0": 17.72, "t1": 19.558, "text": "我最喜歡這顆金球了！", "who": "公主"}, {"t0": 19.678, "t1": 20.929, "text": "拋高高～接住！", "who": "公主"}, {"t0": 21.349, "t1": 23.746, "text": "有一天　她在老水井旁邊玩", "who": "卡洛兒姐姐"}, {"t0": 23.866, "t1": 24.599, "text": "一不小心", "who": "卡洛兒姐姐"}, {"t0": 24.719, "t1": 27.159, "text": "金球咕嚕咕嚕滾進了井裡！", "who": "卡洛兒姐姐"}, {"t0": 27.579, "t1": 29.693, "text": "嗚嗚嗚……我的金球！", "who": "公主"}, {"t0": 29.813, "t1": 31.928, "text": "我的金球掉下去了啦！", "who": "公主"}, {"t0": 32.848, "t1": 33.528, "text": "這時候", "who": "卡洛兒姐姐"}, {"t0": 33.648, "t1": 36.461, "text": "井邊跳出了一隻綠油油的小青蛙", "who": "卡洛兒姐姐"}, {"t0": 36.881, "t1": 38.137, "text": "呱！美麗的公主", "who": "小青蛙"}, {"t0": 38.257, "t1": 40.496, "text": "妳為什麼哭得這麼傷心呢？", "who": "小青蛙"}, {"t0": 40.916, "t1": 43.865, "text": "我的金球掉進井裡了　好深好深", "who": "公主"}, {"t0": 43.985, "t1": 45.2, "text": "我撿不到……", "who": "公主"}, {"t0": 45.62, "t1": 47.308, "text": "我可以幫妳撿回來喔！", "who": "小青蛙"}, {"t0": 47.428, "t1": 49.262, "text": "可是　妳要答應我一件事", "who": "小青蛙"}, {"t0": 49.682, "t1": 51.916, "text": "讓我當妳的好朋友　陪妳一起吃飯", "who": "小青蛙"}, {"t0": 52.036, "t1": 53.157, "text": "一起玩　好不好？", "who": "小青蛙"}, {"t0": 53.577, "t1": 55.468, "text": "好好好　我答應你！", "who": "公主"}, {"t0": 55.588, "t1": 57.525, "text": "快點幫我撿金球嘛！", "who": "公主"}, {"t0": 57.945, "t1": 60.898, "text": "小青蛙撲通一聲跳進井裡　沒多久", "who": "卡洛兒姐姐"}, {"t0": 61.018, "t1": 62.56, "text": "就把金球捧了上來", "who": "卡洛兒姐姐"}, {"t0": 63.48, "t1": 65.553, "text": "哇！我的金球回來了！", "who": "公主"}, {"t0": 65.673, "t1": 66.43, "text": "太棒了！", "who": "公主"}, {"t0": 66.85, "t1": 69.772, "text": "可是公主拿到金球　連謝謝都沒說", "who": "卡洛兒姐姐"}, {"t0": 69.892, "t1": 72.033, "text": "就蹦蹦跳跳地跑回城堡了", "who": "卡洛兒姐姐"}, {"t0": 72.453, "t1": 74.628, "text": "呱呱！公主　等等我呀！", "who": "小青蛙"}, {"t0": 74.748, "t1": 76.116, "text": "妳答應過我的！", "who": "小青蛙"}, {"t0": 77.036, "t1": 77.746, "text": "到了晚上", "who": "卡洛兒姐姐"}, {"t0": 77.866, "t1": 80.238, "text": "國王和公主正要一起吃晚餐", "who": "卡洛兒姐姐"}, {"t0": 80.658, "t1": 82.956, "text": "忽然　門口傳來了聲音", "who": "卡洛兒姐姐"}, {"t0": 83.376, "t1": 86.462, "text": "呱！公主　我來找妳吃飯囉！", "who": "小青蛙"}, {"t0": 86.882, "t1": 87.562, "text": "哎唷！", "who": "公主"}, {"t0": 87.682, "t1": 90.212, "text": "我才不要跟黏黏的青蛙一起吃飯呢！", "who": "公主"}, {"t0": 90.632, "t1": 92.904, "text": "女兒啊　發生什麼事了？", "who": "國王"}, {"t0": 93.324, "t1": 94.747, "text": "我的金球掉進井裡", "who": "公主"}, {"t0": 94.867, "t1": 96.676, "text": "是牠幫我撿回來的……", "who": "公主"}, {"t0": 96.796, "t1": 98.604, "text": "我答應要當牠的好朋友", "who": "公主"}, {"t0": 99.024, "t1": 102.341, "text": "答應別人的事　就一定要做到", "who": "國王"}, {"t0": 102.461, "t1": 103.952, "text": "這叫做守信用", "who": "國王"}, {"t0": 104.372, "t1": 107.757, "text": "而且　牠在妳難過的時候幫助了妳", "who": "國王"}, {"t0": 107.877, "t1": 109.888, "text": "妳更應該好好謝謝牠", "who": "國王"}, {"t0": 110.308, "t1": 114.174, "text": "好嘛……小青蛙　對不起", "who": "公主"}, {"t0": 114.294, "t1": 117.127, "text": "謝謝你幫我撿金球", "who": "公主"}, {"t0": 118.047, "t1": 119.469, "text": "公主遵守了約定", "who": "卡洛兒姐姐"}, {"t0": 119.589, "t1": 122.508, "text": "她和小青蛙一起吃飯　一起唱歌", "who": "卡洛兒姐姐"}, {"t0": 122.628, "t1": 123.609, "text": "一起玩遊戲", "who": "卡洛兒姐姐"}, {"t0": 124.029, "t1": 127.138, "text": "呱呱～公主　跟妳一起玩真開心！", "who": "小青蛙"}, {"t0": 127.558, "t1": 130.279, "text": "嘻嘻　小青蛙　你好好笑喔！", "who": "公主"}, {"t0": 130.399, "t1": 132.447, "text": "你真是我的好朋友！", "who": "公主"}, {"t0": 132.867, "t1": 134.311, "text": "就在公主真心說出", "who": "卡洛兒姐姐"}, {"t0": 134.431, "t1": 136.07, "text": "「好朋友」的那一刻", "who": "卡洛兒姐姐"}, {"t0": 137.59, "t1": 139.649, "text": "一道金色的光芒閃過", "who": "卡洛兒姐姐"}, {"t0": 139.769, "t1": 143.523, "text": "小青蛙竟然變成了一位英俊的王子！", "who": "卡洛兒姐姐"}, {"t0": 143.943, "t1": 145.664, "text": "哇！你　你是誰呀？", "who": "公主"}, {"t0": 146.084, "t1": 148.061, "text": "公主　我就是那隻小青蛙呀！", "who": "王子"}, {"t0": 148.481, "t1": 149.827, "text": "我本來是一位王子", "who": "王子"}, {"t0": 149.947, "t1": 151.292, "text": "被壞巫婆施了魔法", "who": "王子"}, {"t0": 151.412, "t1": 152.941, "text": "只有遇到願意守信用", "who": "王子"}, {"t0": 153.061, "t1": 155.653, "text": "真心對我好的朋友　魔法才會解除", "who": "王子"}, {"t0": 156.073, "t1": 157.202, "text": "謝謝妳遵守了約定", "who": "王子"}, {"t0": 157.322, "t1": 159.075, "text": "也謝謝妳把我當成好朋友！", "who": "王子"}, {"t0": 159.495, "t1": 160.861, "text": "哈哈哈！太好了！", "who": "國王"}, {"t0": 160.981, "t1": 163.275, "text": "今天真是個值得慶祝的日子！", "who": "國王"}, {"t0": 164.195, "t1": 164.902, "text": "從此以後", "who": "卡洛兒姐姐"}, {"t0": 165.022, "t1": 167.589, "text": "公主和王子成了最要好的朋友", "who": "卡洛兒姐姐"}, {"t0": 168.009, "t1": 170.211, "text": "他們每天一起在花園裡玩金球", "who": "卡洛兒姐姐"}, {"t0": 170.331, "t1": 171.461, "text": "過著快樂的日子", "who": "卡洛兒姐姐"}]}