43772d46fb.mp3", "start": 135.794, "dur": 3.323}, {"file": "青蛙王子/voice/s7_1_716e478bdb.mp3", "start": 140.518, "dur": 6.053}, {"file": "青蛙王子/voice/s7_2_846179295a.mp3", "start": 146.871, "dur": 1.841}, {"file": "青蛙王子/voice/s7_3_13d2acb716.mp3", "start": 149.012, "dur": 2.097}, {"file": "青蛙王子/voice/s7_4_a8f739990f.mp3", "start": 151.408, "dur": 7.292}, {"file": "青蛙王子/voice/s7_5_bd7e45550d.mp3", "start": 159.0, "dur": 3.122}, {"file": "青蛙王子/voice/s7_6_b3649eae9a.mp3", "start": 162.422, "dur": 3.901}, {"file": "青蛙王子/voice/s8_1_0b3d250149.mp3", "start": 167.123, "dur": 3.514}, {"file": "青蛙王子/voice/s8_2_c3f7c3347d.mp3", "start": 170.936, "dur": 3.572}], "subs": [{"t0": 0.3, "t1": 0.98, "text": "小朋友", "who": "卡洛兒姐姐"}, {"t0": 1.1, "t1": 3.542, "text": "今天卡洛兒姐姐要說的故事是", "who": "卡洛兒姐姐"}, {"t0": 3.662, "t1": 4.948, "text": "《青蛙王子》！", "who": "卡洛兒姐姐"}, {"t0": 7.568, "t1": 10.658, "text": "很久很久以前　在一座美麗的城堡裡", "who": "卡洛兒姐姐"}, {"t0": 10.778, "t1": 12.69, "text": "住著一位可愛的小公主", "who": "卡洛兒姐姐"}, {"t0": 13.11, "t1": 15.031, "text": "小公主最喜歡的玩具", "who": "卡洛兒姐姐"}, {"t0": 15.151, "t1": 17.3, "text": "就是一顆亮晶晶的金球", "who": "卡洛兒姐姐"}, {"t0": 17.72, "t1": 19.811, "text": "我最喜歡這顆金球了！", "who": "公主"}, {"t0": 19.931, "t1": 21.358, "text": "拋高高～接住！", "who": "公主"}, {"t0": 21.778, "t1": 24.175, "text": "有一天　她在老水井旁邊玩", "who": "卡洛兒姐姐"}, {"t0": 24.295, "t1": 25.029, "text": "一不小心", "who": "卡洛兒姐姐"}, {"t0": 25.149, "t1": 27.588, "text": "金球咕嚕咕嚕滾進了井裡！", "who": "卡洛兒姐姐"}, {"t0": 28.008, "t1": 30.123, "text": "嗚嗚嗚……我的金球！", "who": "公主"}, {"t0": 30.243, "t1": 32.358, "text": "我的金球掉下去了啦！", "who": "公主"}, {"t0": 33.278, "t1": 33.958, "text": "這時候", "who": "卡洛兒姐姐"}, {"t0": 34.078, "t1": 36.89, "text": "井邊跳出了一隻綠油油的小青蛙", "who": "卡洛兒姐姐"}, {"t0": 37.31, "t1": 38.566, "text": "呱！美麗的公主", "who": "小青蛙"}, {"t0": 38.686, "t1": 40.926, "text": "妳為什麼哭得這麼傷心呢？", "who": "小青蛙"}, {"t0": 41.346, "t1": 44.295, "text": "我的金球掉進井裡了　好深好深", "who": "公主"}, {"t0": 44.415, "t1": 45.629, "text": "我撿不到……", "who": "公主"}, {"t0": 46.049, "t1": 47.738, "text": "我可以幫妳撿回來喔！", "who": "小青蛙"}, {"t0": 47.858, "t1": 49.691, "text": "可是　妳要答應我一件事", "who": "小青蛙"}, {"t0": 50.111, "t1": 52.346, "text": "讓我當妳的好朋友　陪妳一起吃飯", "who": "小青蛙"}, {"t0": 52.466, "t1": 53.586, "text": "一起玩　好不好？", "who": "小青蛙"}, {"t0": 54.006, "t1": 55.544, "text": "好好好　我答應你！", "who": "公主"}, {"t0": 55.664, "t1": 57.24, "text": "快點幫我撿金球嘛！", "who": "公主"}, {"t0": 57.66, "t1": 60.613, "text": "小青蛙撲通一聲跳進井裡　沒多久", "who": "卡洛兒姐姐"}, {"t0": 60.733, "t1": 62.275, "text": "就把金球捧了上來", "who": "卡洛兒姐姐"}, {"t0": 63.195, "t1": 65.268, "text": "哇！我的金球回來了！", "who": "公主"}, {"t0": 65.388, "t1": 66.145, "text": "太棒了！", "who": "公主"}, {"t0": 66.565, "t1": 69.487, "text": "可是公主拿到金球　連謝謝都沒說", "who": "卡洛兒姐姐"}, {"t0": 69.607, "t1": 71.748, "text": "就蹦蹦跳跳地跑回城堡了", "who": "卡洛兒姐姐"}, {"t0": 72.168, "t1": 74.343, "text": "呱呱！公主　等等我呀！", "who": "小青蛙"}, {"t0": 74.463, "t1": 75.831, "text": "妳答應過我的！", "who": "小青蛙"}, {"t0": 76.75, "t1": 77.461, "text": "到了晚上", "who": "卡洛兒姐姐"}, {"t0": 77.581, "t1": 79.953, "text": "國王和公主正要一起吃晚餐", "who": "卡洛兒姐姐"}, {"t0": 80.373, "t1": 82.67, "text": "忽然　門口傳來了聲音", "who": "卡洛兒姐姐"}, {"t0": 83.09, "t1": 85.277, "text": "呱！公主　我來找妳吃飯囉！", "who": "小青蛙"}, {"t0": 85.697, "t1": 86.377, "text": "哎唷！", "who": "公主"}, {"t0": 86.497, "t1": 89.827, "text": "我才不要跟黏黏的青蛙一起吃飯呢！", "who": "公主"}, {"t0": 90.247, "t1": 92.52, "text": "女兒啊　發生什麼事了？", "who": "國王"}, {"t0": 92.94, "t1": 96.345, "text": "我的金球掉進井裡", "who": "公主"}, {"t0": 96.465, "t1": 100.752, "text": "是牠幫我撿回來的……", "who": "公主"}, {"t0": 100.872, "t1": 105.159, "text": "我答應要當牠的好朋友", "who": "公主"}, {"t0": 105.579, "t1": 108.895, "text": "答應別人的事　就一定要做到", "who": "國王"}, {"t0": 109.015, "t1": 110.507, "text": "這叫做守信用", "who": "國王"}, {"t0": 110.927, "t1": 114.311, "text": "而且　牠在妳難過的時候幫助了妳", "who": "國王"}, {"t0": 114.431, "t1": 116.442, "text": "妳更應該好好謝謝牠", "who": "國王"}, {"t0": 116.862, "t1": 119.056, "text": "好嘛……小青蛙　對不起", "who": "公主"}, {"t0": 119.176, "t1": 120.769, "text": "謝謝你幫我撿金球", "who": "公主"}, {"t0": 121.689, "t1": 123.111, "text": "公主遵守了約定", "who": "卡洛兒姐姐"}, {"t0": 123.231, "t1": 126.151, "text": "她和小青蛙一起吃飯　一起唱歌", "who": "卡洛兒姐姐"}, {"t0": 126.271, "t1": 127.252, "text": "一起玩遊戲", "who": "卡洛兒姐姐"}, {"t0": 127.672, "t1": 130.78, "text": "呱呱～公主　跟妳一起玩真開心！", "who": "小青蛙"}, {"t0": 131.2, "t1": 133.516, "text": "嘻嘻　小青蛙　你好好笑喔！", "who": "公主"}, {"t0": 133.636, "t1": 135.374, "text": "你真是我的好朋友！", "who": "公主"}, {"t0": 135.794, "t1": 137.238, "text": "就在公主真心說出", "who": "卡洛兒姐姐"}, {"t0": 137.358, "t1": 138.998, "text": "「好朋友」的那一刻", "who": "卡洛兒姐姐"}, {"t0": 140.518, "t1": 142.577, "text": "一道金色的光芒閃過", "who": "卡洛兒姐姐"}, {"t0": 142.697, "t1": 146.451, "text": "小青蛙竟然變成了一位英俊的王子！", "who": "卡洛兒姐姐"}, {"t0": 146.871, "t1": 148.592, "text": "哇！你　你是誰呀？", "who": "公主"}, {"t0": 149.012, "t1": 150.988, "text": "公主　我就是那隻小青蛙呀！", "who": "王子"}, {"t0": 151.408, "t1": 152.754, "text": "我本來是一位王子", "who": "王子"}, {"t0": 152.874, "t1": 154.22, "text": "被壞巫婆施了魔法", "who": "王子"}, {"t0": 154.34, "t1": 155.869, "text": "只有遇到願意守信用", "who": "王子"}, {"t0": 155.989, "t1": 158.58, "text": "真心對我好的朋友　魔法才會解除", "who": "王子"}, {"t0": 159.0, "t1": 160.129, "text": "謝謝妳遵守了約定", "who": "王子"}, {"t0": 160.249, "t1": 162.002, "text": "也謝謝妳把我當成好朋友！", "who": "王子"}, {"t0": 162.422, "t1": 163.788, "text": "哈哈哈！太好了！", "who": "國王"}, {"t0": 163.908, "t1": 166.203, "text": "今天真是個值得慶祝的日子！", "who": "國王"}, {"t0": 167.123, "t1": 167.829, "text": "從此以後", "who": "卡洛兒姐姐"}, {"t0": 167.949, "t1": 170.516, "text": "公主和王子成了最要好的朋友", "who": "卡洛兒姐姐"}, {"t0": 170.936, "t1": 173.138, "text": "他們每天一起在花園裡玩金球", "who": "卡洛兒姐姐"}, {"t0": 173.258, "t1": 174.389, "text": "過著快樂的日子", "who": "卡洛兒姐姐"}]}