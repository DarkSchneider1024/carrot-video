# ===========================
# 大型二進位媒體檔案 (不入 git)
# 請使用 Git LFS 或手動管理
# ===========================

# 影片檔
*.mp4
*.webm
*.avi
*.mov

# 音頻原始/訓練集 (體積過大)
vits_dataset/raw_audio.wav
vits_dataset/clean_mono_44k.wav
vits_dataset/wavs/
public/assets/target_female_voice.wav

# 聲音庫原始音頻 (只保留 voice_profile.json 和小型 sample)
public/voice/*/raw_audio.wav
public/voice/*/raw_download.wav
public/voice/*/clean_mono_44k.wav
public/voice/*/reference.wav

# GIF 動畫幀暫存目錄
public/assets/*_anim_frames/
public/assets/*_sprite.png

# 精靈圖動畫 GIF (可重新生成)
public/assets/*_anim.gif

